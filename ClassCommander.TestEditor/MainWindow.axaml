<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassCommander.TestEditor.MainWindow"
        Width="1180" Height="800" MinWidth="900" MinHeight="620"
        Background="#F0F0F0" RequestedThemeVariant="Light"
        Title="ClassCommander Test Editor">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenuItem">
        <MenuItem x:Name="NewMenuItem" InputGesture="Ctrl+N" Click="NewMenuItem_OnClick" />
        <MenuItem x:Name="OpenMenuItem" InputGesture="Ctrl+O" Click="OpenMenuItem_OnClick" />
        <MenuItem x:Name="SaveMenuItem" InputGesture="Ctrl+S" Click="SaveMenuItem_OnClick" />
        <MenuItem x:Name="SaveAsMenuItem" Click="SaveAsMenuItem_OnClick" />
        <Separator />
        <MenuItem x:Name="ImportMyTestMenuItem" Click="ImportMyTestMenuItem_OnClick" />
        <MenuItem x:Name="BatchMyTestMenuItem" Click="BatchMyTestMenuItem_OnClick" />
        <Separator />
        <MenuItem x:Name="ExitMenuItem" Click="ExitMenuItem_OnClick" />
      </MenuItem>
      <MenuItem x:Name="QuestionsMenuItem">
        <MenuItem x:Name="AddQuestionMenuItem" Click="AddQuestionButton_OnClick" />
        <MenuItem x:Name="DuplicateQuestionMenuItem" Click="DuplicateQuestionMenuItem_OnClick" />
        <MenuItem x:Name="DeleteQuestionMenuItem" Click="DeleteQuestionButton_OnClick" />
        <Separator />
        <MenuItem x:Name="MoveUpMenuItem" Click="MoveUpButton_OnClick" />
        <MenuItem x:Name="MoveDownMenuItem" Click="MoveDownButton_OnClick" />
        <Separator />
        <MenuItem x:Name="ApplyQuestionMenuItem" Click="ApplyChangesButton_OnClick" />
        <MenuItem x:Name="ResetQuestionMenuItem" Click="ResetQuestionMenuItem_OnClick" />
      </MenuItem>
      <MenuItem x:Name="TestParametersMenuItem">
        <MenuItem x:Name="TestSettingsMenuItem" InputGesture="F2" Click="TestSettingsMenuItem_OnClick" />
        <MenuItem x:Name="GroupsMenuItem" Click="GroupsMenuItem_OnClick" />
      </MenuItem>
      <MenuItem x:Name="HelpMenuItem">
        <MenuItem x:Name="EditorHelpMenuItem" Click="EditorHelpMenuItem_OnClick" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#B8B8B8" BorderThickness="0,1,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="NewToolbarButton" Classes="toolbar" Click="NewMenuItem_OnClick" />
        <Button x:Name="OpenToolbarButton" Classes="toolbar" Click="OpenMenuItem_OnClick" />
        <Button x:Name="SaveToolbarButton" Classes="toolbar" Click="SaveMenuItem_OnClick" />
        <Separator Width="1" Margin="6,0" />
        <Button x:Name="AddQuestionButton" Classes="toolbar" Click="AddQuestionButton_OnClick" />
        <Button x:Name="DeleteQuestionButton" Classes="toolbar" Click="DeleteQuestionButton_OnClick" />
        <Button x:Name="MoveUpButton" Classes="toolbar" Click="MoveUpButton_OnClick" />
        <Button x:Name="MoveDownButton" Classes="toolbar" Click="MoveDownButton_OnClick" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,5" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Background="#FAFAFA">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="QuestionCountText" Margin="0,0,16,0" />
        <TextBlock x:Name="StatusTextBlock" Grid.Column="1" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="TestMetaText" Grid.Column="2" Opacity="0.6" Margin="12,0,0,0" />
      </Grid>
    </Border>
    <StackPanel IsVisible="False">
      <TextBlock x:Name="TestTitleLabelText" />
      <TextBox x:Name="TestTitleTextBox" LostFocus="TestTitleTextBox_OnLostFocus" />
      <TextBlock x:Name="GroupTitleLabelText" />
      <TextBox x:Name="GroupTitleTextBox" LostFocus="GroupTitleTextBox_OnLostFocus" />
    </StackPanel>
    <Grid ColumnDefinitions="235,5,*">
      <DockPanel Background="White">
        <TextBlock x:Name="GroupsHeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="10,10,10,6" />
        <ListBox x:Name="QuestionsListBox" SelectionChanged="QuestionsListBox_OnSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2" Margin="2,3">
                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TypeDisplay}" FontSize="11" Opacity="0.65" />
                <TextBlock Text="{Binding PromptPreview}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GroupTitle}" FontSize="11" Opacity="0.5" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#D0D0D0" />
      <DockPanel Grid.Column="2" Margin="8">
        <TextBlock x:Name="EditorHeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
          <Button x:Name="ApplyChangesButton" Click="ApplyChangesButton_OnClick" MinWidth="160" />
          <Button x:Name="ResetQuestionButton" Grid.Column="2" Click="ResetQuestionMenuItem_OnClick" MinWidth="110" />
        </Grid>
        <TextBlock x:Name="EmptyStateText" DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="8,16" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Border x:Name="EditorHost" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
