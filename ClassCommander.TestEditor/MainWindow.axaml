<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassCommander.TestEditor.MainWindow"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        Title="ClassCommander Test Editor">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenuItem" Header="_File">
        <MenuItem x:Name="NewMenuItem" Header="New test" Click="NewMenuItem_OnClick" />
        <MenuItem x:Name="OpenMenuItem" Header="Open .cctest…" Click="OpenMenuItem_OnClick" />
        <MenuItem x:Name="SaveMenuItem" Header="Save" Click="SaveMenuItem_OnClick" />
        <MenuItem x:Name="SaveAsMenuItem" Header="Save As…" Click="SaveAsMenuItem_OnClick" />
        <Separator />
        <MenuItem x:Name="ImportMyTestMenuItem" Header="Import MyTest XML…" Click="ImportMyTestMenuItem_OnClick" />
      </MenuItem>
      <MenuItem x:Name="LanguageMenuItem" Header="_Language">
        <MenuItem x:Name="EnglishMenuItem" Header="English" Click="EnglishMenuItem_OnClick" />
        <MenuItem x:Name="UkrainianMenuItem" Header="Українська" Click="UkrainianMenuItem_OnClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom"
            Padding="12,8"
            BorderBrush="#D0D5DD"
            BorderThickness="0,1,0,0"
            Background="#F8FAFC">
      <TextBlock x:Name="StatusTextBlock" Text="Ready" />
    </Border>

    <Grid Margin="16" ColumnDefinitions="360,*">
      <Border Background="#FFFFFF"
              BorderBrush="#D0D5DD"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12">
        <DockPanel>
          <TextBlock x:Name="GroupsHeadingText"
                     DockPanel.Dock="Top"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"
                     Text="Groups and questions" />
          <ListBox x:Name="QuestionsListBox"
                   SelectionChanged="QuestionsListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding GroupTitle}"
                             FontSize="11"
                             Opacity="0.7" />
                  <TextBlock Text="{Binding Display}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Margin="16,0,0,0"
              Background="#FFFFFF"
              BorderBrush="#D0D5DD"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16">
        <DockPanel>
          <Border DockPanel.Dock="Top"
                  Margin="0,0,0,12"
                  Padding="0,0,0,12"
                  BorderBrush="#E4E7EC"
                  BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
              <TextBlock x:Name="TestTitleText"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Text="—" />
              <TextBlock x:Name="TestMetaText"
                         Opacity="0.75"
                         TextWrapping="Wrap"
                         Text="" />
            </StackPanel>
          </Border>
          <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock x:Name="PreviewHeadingText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Question preview" />
            <TextBlock x:Name="EmptyStateText"
                       Text="No test loaded."
                       TextWrapping="Wrap"
                       Opacity="0.75" />

            <StackPanel x:Name="PreviewPanel" IsVisible="False" Spacing="10">
              <TextBlock x:Name="TypeLabelText" FontWeight="SemiBold" Text="Type" />
              <TextBlock x:Name="TypeValueText" TextWrapping="Wrap" />

              <TextBlock x:Name="ScoreLabelText" FontWeight="SemiBold" Text="Score" />
              <TextBlock x:Name="ScoreValueText" />

              <TextBlock x:Name="PromptLabelText" FontWeight="SemiBold" Text="Prompt" />
              <TextBlock x:Name="PromptValueText" TextWrapping="Wrap" />

              <TextBlock x:Name="OptionsLabelText" FontWeight="SemiBold" Text="Options / interaction" />
              <TextBlock x:Name="OptionsValueText" TextWrapping="Wrap" />

              <TextBlock x:Name="AnswerKeyLabelText" FontWeight="SemiBold" Text="Answer key" />
              <TextBlock x:Name="AnswerKeyValueText" TextWrapping="Wrap" />

              <TextBlock x:Name="AssetsLabelText" FontWeight="SemiBold" Text="Assets" />
              <TextBlock x:Name="AssetsValueText" TextWrapping="Wrap" />

              <TextBlock x:Name="WarningsLabelText" FontWeight="SemiBold" Text="Import warnings" IsVisible="False" />
              <TextBlock x:Name="WarningsValueText" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
