<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TeacherClient.CrossPlatform.Dialogs.TestingWindow"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="ClassCommander Testing">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Margin="0,0,0,12">
      <MenuItem x:Name="LaunchMenuItem">
        <MenuItem x:Name="StartSelectedMenuItem" Click="StartSelectedMenuItem_OnClick" />
        <MenuItem x:Name="StartAllOnlineMenuItem" Click="StartAllOnlineMenuItem_OnClick" />
      </MenuItem>
      <MenuItem x:Name="ToolsMenuItem">
        <MenuItem x:Name="DeployRunnerMenuItem" Click="DeployRunnerMenuItem_OnClick" />
        <Separator />
        <MenuItem x:Name="ExitCodesMenuItem" Click="ExitCodesMenuItem_OnClick" />
      </MenuItem>
    </Menu>
    <DockPanel Margin="16,0,16,16">
      <Border DockPanel.Dock="Top"
              Padding="0,0,0,12"
              BorderBrush="#D0D5DD"
              BorderThickness="0,0,0,1"
              Margin="0,0,0,12">
        <StackPanel Spacing="8">
          <TextBlock x:Name="ConnectionStatusText"
                     Opacity="0.85" />
          <TextBlock x:Name="LaunchAssignmentLabel" />
          <ComboBox x:Name="LaunchAssignmentComboBox" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="LaunchHintText"
                     Opacity="0.75"
                     TextWrapping="Wrap"
                     FontSize="12" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusTextBlock"
                 DockPanel.Dock="Bottom"
                 Margin="0,12,0,0"
                 Opacity="0.85" />

      <TabControl x:Name="MainTabControl">
        <TabItem x:Name="TestsTabItem">
          <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
              <Button x:Name="RefreshTestsButton" MinWidth="100" Click="RefreshTestsButton_OnClick" />
              <Button x:Name="ImportMyTestButton" MinWidth="140" Click="ImportMyTestButton_OnClick" />
              <Button x:Name="ImportCctestButton" MinWidth="140" Click="ImportCctestButton_OnClick" />
              <Button x:Name="CreateAssignmentButton" MinWidth="140" Click="CreateAssignmentButton_OnClick" />
            </StackPanel>
            <DataGrid x:Name="TestsGrid"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single" />
          </DockPanel>
        </TabItem>

        <TabItem x:Name="AssignmentsTabItem">
          <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
              <Button x:Name="RefreshAssignmentsButton" MinWidth="100" Click="RefreshAssignmentsButton_OnClick" />
              <Button x:Name="CloseAssignmentButton" MinWidth="140" Click="CloseAssignmentButton_OnClick" />
              <Button x:Name="OpenMonitorButton" MinWidth="140" Click="OpenMonitorButton_OnClick" />
            </StackPanel>
            <DataGrid x:Name="AssignmentsGrid"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single" />
          </DockPanel>
        </TabItem>

        <TabItem x:Name="MonitorTabItem">
          <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="MonitorAssignmentLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="MonitorAssignmentComboBox" Width="300">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="RefreshMonitorButton" MinWidth="100" Click="RefreshMonitorButton_OnClick" />
                <Button x:Name="ViewResultButton" MinWidth="140" Click="ViewResultButton_OnClick" />
              </StackPanel>
              <TextBlock x:Name="MonitorStatusText" TextWrapping="Wrap" />
            </StackPanel>
            <Grid RowDefinitions="*,Auto,*">
              <DockPanel>
                <TextBlock x:Name="AttemptsHeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid x:Name="AttemptsGrid"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single" />
              </DockPanel>
              <Border Grid.Row="1" Height="12" />
              <DockPanel Grid.Row="2">
                <TextBlock x:Name="ResultsHeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid x:Name="ResultsGrid"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single" />
              </DockPanel>
            </Grid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</Window>
